# --- Secrets (never commit these) ---
.env
.env.*
*.key
*.pem
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets.*
credentials*
config.local.*
*.kdbx

# --- Raw data that may hold real IPs or personal info ---
*.pcap
*.pcapng
*.log
raw/
private/
exports/

# --- Screenshots until I've reviewed them ---
screenshots-raw/
Screenshot*.png
Screen Shot*.png

# --- Python / editor / OS noise ---
__pycache__/
*.pyc
.venv/
venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
